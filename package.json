{
  "name": "react-webview-vite",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dependencyLinks.openPanel",
    "onCommand:dependencyLinks.openDependencyGraph",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dependencyLinks.openPanel",
        "title": "%command.openInspector.title%"
      },
      {
        "command": "dependencyLinks.openDependencyGraph",
        "title": "%command.openDependencyGraph.title%"
      }
    ],
    "submenus": [
      {
        "id": "dependencyLinks.webviewMenu",
        "label": "%submenu.dependencyLinks.label%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "dependencyLinks.webviewMenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "dependencyLinks.webviewMenu",
          "group": "navigation"
        }
      ],
      "dependencyLinks.webviewMenu": [
        {
          "command": "dependencyLinks.openPanel",
          "group": "navigation@1"
        },
        {
          "command": "dependencyLinks.openDependencyGraph",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run clean && npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "concurrently -k -n extension,webview \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "vite build --watch --mode development --config vite.extension.config.ts",
    "watch:webview": "vite build --watch --mode development --config vite.webview.config.ts",
    "dev": "concurrently -k -n extension,webview,preview,vscode \"npm run watch:extension\" \"npm run watch:webview\" \"npm run dev:preview\" \"npm run dev:extension\"",
    "dev:preview": "vite --config vite.webview.config.ts --host 127.0.0.1 --open /previews/inspector.html",
    "dev:extension": "node ./scripts/run-extension-dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.webview.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "npm run build && npm run lint && npm run typecheck",
    "lint": "eslint src",
    "test": "vscode-test",
    "deps:check": "npx --yes dependency-cruiser@18.4.0 src",
    "deps:graph": "npx --yes dependency-cruiser@18.4.0 --output-type mermaid src",
    "l10n:extract": "npx --yes @vscode/l10n-dev@0.0.35 export --outDir ./l10n ./src",
    "l10n:pseudo": "npx --yes @vscode/l10n-dev@0.0.35 generate-pseudo -o ./l10n ./l10n/bundle.l10n.json ./package.nls.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.118.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.10"
  },
  "l10n": "./l10n"
}
