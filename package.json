{
  "name": "vscode-dependency-links",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:dependencyLinks.openPanel",
    "onCommand:dependencyLinks.openDependencyGraph",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dependencyLinks.openPanel",
        "title": "%command.openInspector.title%"
      },
      {
        "command": "dependencyLinks.openDependencyGraph",
        "title": "%command.openDependencyGraph.title%"
      }
    ],
    "submenus": [
      {
        "id": "dependencyLinks.webviewMenu",
        "label": "%submenu.dependencyLinks.label%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "dependencyLinks.webviewMenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "dependencyLinks.webviewMenu",
          "group": "navigation"
        }
      ],
      "dependencyLinks.webviewMenu": [
        {
          "command": "dependencyLinks.openPanel",
          "group": "navigation@1"
        },
        {
          "command": "dependencyLinks.openDependencyGraph",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run clean && npm run build:extension && npm run build:webview",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:webview": "vite build --config vite.webview.config.ts",
    "watch": "concurrently -k -n extension,webview \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "vite build --watch --mode development --config vite.extension.config.ts",
    "watch:webview": "vite build --watch --mode development --config vite.webview.config.ts",
    "dev": "npm run dev:preview",
    "dev:preview": "vite --config vite.webview.config.ts --host 127.0.0.1 --open /previews/inspector.html",
    "dev:extension": "node ./scripts/run-extension-dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.webview.json",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "pretest": "npm run build && npm run lint && npm run typecheck",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:vscode",
    "deps:check": "npx --yes dependency-cruiser@18.4.0 src",
    "deps:graph": "npx --yes dependency-cruiser@18.4.0 --output-type mermaid src",
    "l10n:extract": "npx --yes @vscode/l10n-dev@0.0.35 export --outDir ./l10n ./src",
    "l10n:pseudo": "npx --yes @vscode/l10n-dev@0.0.35 generate-pseudo -o ./l10n ./l10n/bundle.l10n.json ./package.nls.json",
    "l10n:xlf": "npx --yes @vscode/l10n-dev@0.0.35 generate-xlf -o ./l10n/dependency-links.xlf ./l10n/bundle.l10n.json ./package.nls.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:vscode": "node ./scripts/run-vscode-tests.mjs",
    "package:list": "vsce ls",
    "package": "vsce package --no-rewrite-relative-links",
    "prepackage": "npm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.118.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.10",
    "vitest": "^5.0.3",
    "@vscode/vsce": "^3.6.2"
  },
  "l10n": "./l10n",
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xyflow/react": "^12.12.0",
    "monaco-editor": "0.57.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moyarich/vscode-dependency-links.git"
  },
  "homepage": "https://github.com/moyarich/vscode-dependency-links#readme",
  "bugs": {
    "url": "https://github.com/moyarich/vscode-dependency-links/issues"
  },
  "license": "MIT"
}
