{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/utils/**/*.ts",
    "src/webview-ui/**/*.ts",
    "src/webview-ui/**/*.tsx",
    "src/webview-ui/**/*.d.ts"
  ],
  "exclude": ["src/extension.ts", "src/extension/**", "src/test/**", "node_modules", "out"]
}
